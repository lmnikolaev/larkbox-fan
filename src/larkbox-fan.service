[Unit]
Description=Chuwi LarkBox fan control (polls ACPI SEN4._TMP)
Documentation=https://github.com/lmnikolaev/larkbox-fan file:/usr/share/doc/larkbox-fan/README
ConditionFirmware=smbios-field(product_name $= LarkBox*)

[Service]
Type=simple
ExecStart=/usr/libexec/larkbox-fan/larkbox-fan
Restart=on-failure
RestartSec=5
# The poller only reads sysfs; lock everything else down.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
